{
  "name": "@polygonlabs/maticjs",
  "version": "3.9.13",
  "description": "TypeScript SDK for the Polygon PoS bridge — supports viem, ethers v5, and ethers v6",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@polygonlabs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./viem": {
      "@polygonlabs/source": "./src/adapters/viem.ts",
      "types": "./dist/adapters/viem.d.ts",
      "import": "./dist/adapters/viem.js",
      "default": "./dist/adapters/viem.js"
    },
    "./ethers-v5": {
      "@polygonlabs/source": "./src/adapters/ethers-v5.ts",
      "types": "./dist/adapters/ethers-v5.d.ts",
      "import": "./dist/adapters/ethers-v5.js",
      "default": "./dist/adapters/ethers-v5.js"
    },
    "./ethers-v6": {
      "@polygonlabs/source": "./src/adapters/ethers-v6.ts",
      "types": "./dist/adapters/ethers-v6.d.ts",
      "import": "./dist/adapters/ethers-v6.js",
      "default": "./dist/adapters/ethers-v6.js"
    },
    "./abi": {
      "@polygonlabs/source": "./src/abi/index.ts",
      "types": "./dist/abi/index.d.ts",
      "import": "./dist/abi/index.js",
      "default": "./dist/abi/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xPolygon/matic.js.git",
    "directory": "packages/maticjs"
  },
  "files": [
    "dist",
    "MIGRATION.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/fix-dts-specifiers.mjs",
    "clean": "rimraf dist",
    "codegen": "node scripts/generate-abis.ts",
    "codegen-drift-check": "pnpm run codegen && git diff --exit-code -- src/abi",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pack": "node scripts/pack-smoke.mjs",
    "check:error-ownership": "node scripts/check-error-ownership.mjs"
  },
  "keywords": [
    "polygon",
    "pos",
    "bridge",
    "ethereum",
    "viem",
    "ethers"
  ],
  "author": "Polygon Labs",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./viem": {
        "types": "./dist/adapters/viem.d.ts",
        "import": "./dist/adapters/viem.js",
        "default": "./dist/adapters/viem.js"
      },
      "./ethers-v5": {
        "types": "./dist/adapters/ethers-v5.d.ts",
        "import": "./dist/adapters/ethers-v5.js",
        "default": "./dist/adapters/ethers-v5.js"
      },
      "./ethers-v6": {
        "types": "./dist/adapters/ethers-v6.d.ts",
        "import": "./dist/adapters/ethers-v6.js",
        "default": "./dist/adapters/ethers-v6.js"
      },
      "./abi": {
        "types": "./dist/abi/index.d.ts",
        "import": "./dist/abi/index.js",
        "default": "./dist/abi/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "bugs": {
    "url": "https://github.com/0xPolygon/matic.js/issues"
  },
  "homepage": "https://github.com/0xPolygon/matic.js#readme",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "ethers": "^5.6.0 || ^6.0.0",
    "viem": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    },
    "ethers": {
      "optional": true
    }
  },
  "dependencies": {
    "@ethereumjs/mpt": "10.1.2",
    "@ethereumjs/rlp": "10.1.2",
    "@noble/hashes": "2.2.0",
    "@polygonlabs/verror": "^1.1.0"
  },
  "devDependencies": {
    "@polygonlabs/meta": "^1.1.1",
    "@tsconfig/node20": "^20.0.0",
    "ethers-v5": "npm:ethers@^5.8.0",
    "rimraf": "^5.0.0",
    "tsup": "8.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
