{
  "name": "maticjs-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "eslint .",
    "lint:ts": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run typecheck",
    "ci:publish": "pnpm exec changeset publish",
    "test": "pnpm -r --if-present run test",
    "e2e": "pnpm --filter @polygonlabs/maticjs-e2e run e2e"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "^25.5.0"
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@polygonlabs/apps-team-lint": "^2.3.0",
    "@tsconfig/node-ts": "^23.6.5",
    "@tsconfig/node20": "^20.1.11",
    "@tsconfig/node24": "^24.0.6",
    "eslint": "^10.14.0",
    "husky": "^9.0.0",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.24.1",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
